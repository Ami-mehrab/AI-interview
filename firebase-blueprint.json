{
  "entities": {
    "JobDescription": {
      "title": "Job Description",
      "description": "Details about a job role and its requirements.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "description": "The title of the role." },
        "description": { "type": "string", "description": "The full JD text." },
        "generatedQuestions": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of questions generated by AI for this JD."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID of the recruiter." }
      },
      "required": ["role", "description", "createdBy"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Details about a candidate and their specific interview session.",
      "type": "object",
      "properties": {
        "candidate_name": { "type": "string" },
        "candidate_email": { "type": "string", "format": "email" },
        "applied_role": { "type": "string" },
        "job_description": { "type": "string" },
        "generated_questions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of questions generated for this candidate."
        },
        "approved_questions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of recruiter-approved questions for the interview."
        },
        "questions_approved": { "type": "boolean" },
        "status": { "type": "string", "enum": ["uploaded", "questions_generated", "approved", "interview_started", "interview_completed", "completed", "evaluated"] },
        "session_status": { "type": "string", "enum": ["pending", "open", "in-progress", "expired", "completed"] },
        "interview_link": { "type": "string" },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "speaker": { "type": "string", "enum": ["assistant", "user", "InterviewGenie", "Candidate"] },
              "text": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "transcript_text": { "type": "string" },
        "evaluation": { "type": "object" },
        "evaluation_json": { "type": "object" },
        "score": { "type": "number" },
        "interview_screenshot_url": { "type": "string" },
        "window_expires_at": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" }
      },
      "required": ["candidate_name", "applied_role", "createdBy"]
    },
    "Interview": {
      "title": "Interview",
      "description": "A single interview conducted for a candidate.",
      "type": "object",
      "properties": {
        "candidate_id": { "type": "string" },
        "candidate_name": { "type": "string" },
        "approved_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "text": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "evaluation_json": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "in-progress", "completed"] },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" }
      },
      "required": ["candidate_id", "candidate_name"]
    }
  },
  "firestore": {
    "/jobDescriptions/{jdId}": {
      "schema": "JobDescription",
      "description": "Collection of job descriptions."
    },
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Collection of candidates and their interview data."
    }
  }
}
